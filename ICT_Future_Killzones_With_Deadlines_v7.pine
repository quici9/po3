//@version=6
// v7: v6 killzones/deadlines + CISD+FVG setup marker for the 03:00 and 09:00 NY hours (M1 only).
// Logic mirrors docs/analysis-2026-09-21/verify_indicator.py (rule v1.1). Keep both in sync.
indicator("ICT Killzones + CISD/FVG Setup (v7, M1)", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 100, max_bars_back = 500)

TZ = "America/New_York"
// Mốc "hiện tại" = thời gian nến cuối trên chart: trong Bar Replay chính là vị trí đang replay (timenow là giờ thật, sẽ sai).
NOW = last_bar_time
HOUR_MS = 3600000
DAY_MS  = 86400000

// =============================================================================
// CẤU HÌNH
// =============================================================================
grp_ln = "London Focus (03:00 - 04:00 NY)"
enable_london = input.bool(true, "Bật London Focus", group = grp_ln)
col_london    = input.color(color.blue, "Màu London", group = grp_ln)

grp_ny = "New York AM Focus (09:00 - 10:00 NY)"
enable_ny     = input.bool(true, "Bật New York AM Focus", group = grp_ny)
col_ny        = input.color(color.orange, "Màu New York AM", group = grp_ny)

grp_dl = "Mốc Deadline (03:30 & 09:30 NY)"
enable_deadlines  = input.bool(true, "Bật hiển thị Deadline", group = grp_dl)
col_deadline      = input.color(color.red, "Màu đường Deadline", group = grp_dl)
deadline_style_in = input.string("Dotted", "Kiểu đường Deadline", options = ["Dotted", "Dashed", "Solid"], group = grp_dl)
dl_style = deadline_style_in == "Solid" ? line.style_solid : deadline_style_in == "Dashed" ? line.style_dashed : line.style_dotted

grp_sg = "Setup CISD + FVG (quy tắc v1.1, chỉ M1, giờ 03:00 & 09:00 NY, T3/T4/T5)"
enable_sig    = input.bool(true, "Bật đánh dấu setup", group = grp_sg)
days_back     = input.int(10, "Số ngày lịch sử hiển thị", minval = 1, maxval = 60, group = grp_sg)
min_fvg_pip   = input.float(0.5, "FVG tối thiểu (pip). 0 = khớp script gốc", minval = 0, step = 0.1, group = grp_sg)
sweep_max_min = input.int(30, "Quét muộn nhất (phút)", minval = 1, maxval = 59, group = grp_sg)
cisd_max_min  = input.int(29, "Nến CISD muộn nhất (phút)", minval = 1, maxval = 59, group = grp_sg)
depth_max_atr = input.float(0.25, "Độ sâu quét tối đa (ATR)", minval = 0.05, step = 0.05, group = grp_sg)
col_buy       = input.color(color.teal, "Màu tín hiệu mua", group = grp_sg)
col_sell      = input.color(color.maroon, "Màu tín hiệu bán", group = grp_sg)
show_status   = input.bool(true, "Bảng trạng thái (góc trên phải)", group = grp_sg)
show_sweep    = input.bool(true, "Đánh dấu điểm quét (tại cực trị của swing, tooltip)", group = grp_sg)
show_prev_hl  = input.bool(true, "Vẽ đỉnh/đáy giờ trước (từ nến tạo đỉnh/đáy đến hết giờ setup)", group = grp_sg)
col_prev_hl   = input.color(color.gray, "Màu đỉnh/đáy giờ trước", group = grp_sg)
alert_cisd    = input.bool(true, "Alert ngay khi phát hiện CISD (kể cả khi bị bỏ vì quét sâu / không FVG)", group = grp_sg)

grp_hl = "Mức High/Low: Killzone, ngày trước, tuần trước"
show_kz_hl   = input.bool(true, "Vẽ High/Low killzone (Asia, London, New York)", group = grp_hl)
sess_asia    = input.session("2000-0000", "Asia (giờ NY)", group = grp_hl)
sess_london  = input.session("0200-0500", "London (giờ NY)", group = grp_hl)
sess_ny      = input.session("0700-1100", "New York (giờ NY)", group = grp_hl)
col_asia_hl  = input.color(color.purple, "Màu Asia", group = grp_hl)
col_ldn_hl   = input.color(color.blue, "Màu London", group = grp_hl)
col_ny_hl    = input.color(color.orange, "Màu New York", group = grp_hl)
show_kz_box  = input.bool(true, "Tô vùng killzone (từ High đến Low của phiên)", group = grp_hl)
kz_box_transp = input.int(88, "Độ trong suốt vùng tô (%)", minval = 50, maxval = 98, group = grp_hl)
show_pd_hl   = input.bool(true, "Vẽ High/Low ngày trước (PDH/PDL)", group = grp_hl)
col_pd_hl    = input.color(color.yellow, "Màu PDH/PDL", group = grp_hl)
show_pw_hl   = input.bool(true, "Vẽ High/Low tuần trước (PWH/PWL)", group = grp_hl)
col_pw_hl    = input.color(color.white, "Màu PWH/PWL", group = grp_hl)
hl_days_back = input.int(1, "Số ngày hiển thị (1 = chỉ hôm nay; tuần: 1 = chỉ tuần này)", minval = 1, maxval = 30, group = grp_hl)
hl_width     = input.int(1, "Độ dày đường", minval = 1, maxval = 3, group = grp_hl)
hl_lbl_off   = input.int(6, "Nhãn cách nến hiện tại (số nến, đặt trong lề phải)", minval = 1, maxval = 30, group = grp_hl)
hl_hide_swept = input.bool(false, "Ẩn nhãn của đường đã bị quét", group = grp_hl)

grp_dbg = "Debug / kiểm chứng"
show_debug    = input.bool(false, "Bật lớp debug (biên giờ trước, lý do bỏ, bảng đối chiếu, Pine Logs)", group = grp_dbg)
debug_rows    = input.int(20, "Số dòng bảng đối chiếu", minval = 5, maxval = 60, group = grp_dbg)

// =============================================================================
// PHẦN CŨ: KILLZONE TƯƠNG LAI + DEADLINE (giữ nguyên v6, chỉ sửa ngày alert)
// =============================================================================
var array<line>  lines_arr  = array.new<line>()
var array<label> labels_arr = array.new<label>()

f_clear_objects() =>
    if array.size(lines_arr) > 0
        for i = 0 to array.size(lines_arr) - 1
            line.delete(array.get(lines_arr, i))
        array.clear(lines_arr)
    if array.size(labels_arr) > 0
        for i = 0 to array.size(labels_arr) - 1
            label.delete(array.get(labels_arr, i))
        array.clear(labels_arr)

f_add_vline(int t, color c, string st, int w) =>
    l = line.new(x1 = t, y1 = low, x2 = t, y2 = high, xloc = xloc.bar_time, extend = extend.both, color = c, style = st, width = w)
    array.push(lines_arr, l)

f_add_label(int t, string txt, color c) =>
    lb = label.new(x = t, y = high, text = txt, xloc = xloc.bar_time, color = color.new(c, 100), textcolor = c, style = label.style_label_down, size = size.small)
    array.push(labels_arr, lb)

f_draw_future_killzone(int start_t, int deadline_t, int end_t, color c, string title_str, string dl_title) =>
    if end_t > NOW
        f_add_vline(start_t, c, line.style_solid, 1)
        f_add_label(start_t, title_str, c)
        if enable_deadlines
            f_add_vline(deadline_t, col_deadline, dl_style, 1)
            f_add_label(deadline_t, dl_title, col_deadline)
        f_add_vline(end_t, c, line.style_dashed, 1)

if barstate.islast
    f_clear_objects()
    int y_now   = year(NOW, TZ)
    int m_now   = month(NOW, TZ)
    int d_now   = dayofmonth(NOW, TZ)
    int dow_now = dayofweek(NOW, TZ)
    int days_to_friday = 6 - dow_now
    if days_to_friday >= 0
        for i = 0 to days_to_friday
            int day_anchor = timestamp(TZ, y_now, m_now, d_now + i, 0, 0, 0)
            int y_i   = year(day_anchor, TZ)
            int m_i   = month(day_anchor, TZ)
            int d_i   = dayofmonth(day_anchor, TZ)
            int dow_i = dayofweek(day_anchor, TZ)
            bool is_target_day = dow_i == dayofweek.tuesday or dow_i == dayofweek.wednesday or dow_i == dayofweek.thursday
            if is_target_day
                if enable_london
                    f_draw_future_killzone(timestamp(TZ, y_i, m_i, d_i, 3, 0, 0), timestamp(TZ, y_i, m_i, d_i, 3, 30, 0), timestamp(TZ, y_i, m_i, d_i, 4, 0, 0), col_london, "London 03:00", "Deadline 03:30")
                if enable_ny
                    f_draw_future_killzone(timestamp(TZ, y_i, m_i, d_i, 9, 0, 0), timestamp(TZ, y_i, m_i, d_i, 9, 30, 0), timestamp(TZ, y_i, m_i, d_i, 10, 0, 0), col_ny, "NY AM 09:00", "Deadline 09:30")

// Alert mốc giờ: lọc ngày theo thời gian của nến (v6 dùng timenow, sai trên lịch sử)
bar_dow = dayofweek(time, TZ)
is_alert_day = bar_dow == dayofweek.tuesday or bar_dow == dayofweek.wednesday or bar_dow == dayofweek.thursday
in_lon_start = not na(time(timeframe.period, "0300-0301:345", TZ))
in_lon_dl    = not na(time(timeframe.period, "0330-0331:345", TZ))
in_ny_start  = not na(time(timeframe.period, "0900-0901:345", TZ))
in_ny_dl     = not na(time(timeframe.period, "0930-0931:345", TZ))
if is_alert_day and enable_london and in_lon_start and not in_lon_start[1]
    alert("Bắt đầu London Focus (03:00 NY) - T3/T4/T5!", alert.freq_once_per_bar)
if is_alert_day and enable_deadlines and in_lon_dl and not in_lon_dl[1]
    alert("CẢNH BÁO: Mốc London Deadline (03:30 NY)!", alert.freq_once_per_bar)
if is_alert_day and enable_ny and in_ny_start and not in_ny_start[1]
    alert("Bắt đầu New York AM Focus (09:00 NY) - T3/T4/T5!", alert.freq_once_per_bar)
if is_alert_day and enable_deadlines and in_ny_dl and not in_ny_dl[1]
    alert("CẢNH BÁO: Mốc New York Deadline / Equities Open (09:30 NY)!", alert.freq_once_per_bar)

// =============================================================================
// SETUP CISD + FVG (M1)
// =============================================================================
is_m1   = timeframe.period == "1"
pip     = syminfo.type == "forex" ? syminfo.mintick * 10 : syminfo.mintick
is_pair = str.contains(syminfo.ticker, "EURUSD") or str.contains(syminfo.ticker, "GBPUSD")
min_gap = min_fvg_pip * pip

f_p(float px) => str.tostring(px, format.mintick)
f_2(float x)  => str.tostring(x, "0.00")
f_1(float x)  => str.tostring(x, "0.0")
f_m(int m)    => "p" + (m < 10 ? "0" : "") + str.tostring(m)

// Mức CISD mua: open của chuỗi nến giảm liên tiếp dẫn vào nến đáy (offset k), nhìn lùi tối đa 60 nến.
// Trả về [mức, offset nến gốc của mức] để vẽ đường CISD từ nến gốc đến nến xác nhận.
f_cisd_lvl_buy(int k) =>
    int kk = k
    if not (close[kk] < open[kk])
        kk += 1
    float lvl = open[k]
    int org = k
    if kk <= k + 60 and close[kk] < open[kk]
        while kk + 1 <= k + 60 and close[kk + 1] < open[kk + 1]
            kk += 1
        lvl := open[kk]
        org := kk
    [lvl, org]

f_cisd_lvl_sell(int k) =>
    int kk = k
    if not (close[kk] > open[kk])
        kk += 1
    float lvl = open[k]
    int org = k
    if kk <= k + 60 and close[kk] > open[kk]
        while kk + 1 <= k + 60 and close[kk + 1] > open[kk + 1]
            kk += 1
        lvl := open[kk]
        org := kk
    [lvl, org]

// Đường CISD: nằm ngang tại mức CISD, từ nến gốc (open của chuỗi nến ngược chiều) đến nến xác nhận.
f_draw_cisd(int org_bar, int cisd_bar, float lvl, color c) =>
    line.new(org_bar, lvl, cisd_bar, lvl, xloc = xloc.bar_index, color = c, style = line.style_solid, width = 2)

// nhãn CISD: chữ nhỏ dưới-giữa đường, mũi chỉ lên đường; chi tiết trong tooltip
f_cisd_label(int org_bar, int cisd_bar, float lvl, color c, string txt, string tip) =>
    label.new(math.round((org_bar + cisd_bar) / 2), lvl, txt, xloc = xloc.bar_index, style = label.style_label_up, color = color.new(c, 20), textcolor = color.white, size = size.tiny, tooltip = tip)

// FVG đầu tiên (>= min_gap) trong chân đẩy: nến giữa i từ lo+1 .. bar hiện tại-1. k_lo = offset nến đáy.
// Trả về [offset nến hoàn thành FVG, bottom, top] (offset na = không có).
f_fvg_buy(int k_lo) =>
    int fo = na
    float bot = na
    float top = na
    if k_lo >= 2
        for oi = k_lo - 1 to 1
            float b = high[oi + 1]
            float t = low[oi - 1]
            if t - b >= min_gap and t > b
                fo := oi - 1
                bot := b
                top := t
                break
    [fo, bot, top]

f_fvg_sell(int k_hi) =>
    int fo = na
    float bot = na
    float top = na
    if k_hi >= 2
        for oi = k_hi - 1 to 1
            float t = low[oi + 1]
            float b = high[oi - 1]
            if t - b >= min_gap and t > b
                fo := oi - 1
                bot := b
                top := t
                break
    [fo, bot, top]

// ---- trạng thái giờ ----
var int   cur_hs   = na          // thời điểm bắt đầu giờ hiện tại (ms)
var float ch_hi    = na
var float ch_lo    = na
var int   ch_hi_bar = na       // nến tạo đỉnh/đáy giờ hiện tại
var int   ch_lo_bar = na
var int   ch_bars  = 0
var float ph       = na          // đỉnh/đáy giờ trước
var float pl       = na
var int   ph_bar   = na
var int   pl_bar   = na
var bool  prev_ok  = false
var array<float> h1_rng = array.new<float>()
var float atr      = na          // trung bình (high-low) 24 nến H1 đã đóng, tối thiểu 12 mẫu

// ---- trạng thái setup trong giờ ----
var bool   in_scope   = false
var bool   in_window  = false
var bool   target_hr  = false
var bool   open_in    = false
var string skip_hour  = ""
var int    lo_bar     = na
var float  lo_px      = na
var int    sw_lo_min  = na
var int    hi_bar     = na
var float  hi_px      = na
var int    sw_hi_min  = na
var label  sw_lo_lb   = na       // chấm đánh dấu cực trị quét
var label  sw_hi_lb   = na
var int    cisd_b     = na
var int    cisd_s     = na
var int    cisd_b_org = na       // nến gốc của mức CISD
var int    cisd_s_org = na
var float  cisd_b_lvl = na
var float  cisd_s_lvl = na
var float  depth_b    = na
var float  depth_s    = na
var bool   buy_done   = false
var bool   sell_done  = false
var string res_b      = ""
var string res_s      = ""
var string cur_state  = "chờ"
var array<string> dbg_rows = array.new<string>()

f_push_row(string s) =>
    array.push(dbg_rows, s)
    if array.size(dbg_rows) > debug_rows
        array.shift(dbg_rows)
    if show_debug
        log.info(s)

f_hour_row() =>
    string head = str.format_time(cur_hs, "yyyy-MM-dd EEE HH:00", TZ) + " | ATR " + f_1(atr / pip) + "p | PH " + f_p(ph) + " PL " + f_p(pl)
    string body = skip_hour != "" ? " | " + skip_hour : " | L: " + res_b + " | S: " + res_s
    head + body

f_sess() => syminfo.ticker + " " + (hour(time, TZ) == 3 ? "London 03:00" : "NY AM 09:00")

f_side_prefix(int sw_min, int cisd_bar, float depth) =>
    string s = "sweep " + f_m(sw_min)
    if not na(cisd_bar)
        s += " CISD " + f_m(minute(time[bar_index - cisd_bar], TZ)) + " depth " + f_2(depth)
    s

if barstate.isconfirmed and enable_sig and is_m1
    int hs = time - time % HOUR_MS
    bool new_hour = na(cur_hs) or hs != cur_hs
    int m = minute(time, TZ)

    if new_hour
        // 1. chốt giờ vừa xong
        if not na(cur_hs)
            array.push(h1_rng, ch_bars >= 30 ? ch_hi - ch_lo : float(na))
            if array.size(h1_rng) > 24
                array.shift(h1_rng)
            float sum = 0.0
            int cnt = 0
            for i = 0 to array.size(h1_rng) - 1
                float r = array.get(h1_rng, i)
                if not na(r)
                    sum += r
                    cnt += 1
            atr := cnt >= 12 ? sum / cnt : float(na)
            if target_hr and in_window
                if in_scope and skip_hour == ""
                    if not buy_done
                        res_b := na(sw_lo_min) ? "no sweep" : f_side_prefix(sw_lo_min, cisd_b, depth_b) + " -> no CISD"
                    if not sell_done
                        res_s := na(sw_hi_min) ? "no sweep" : f_side_prefix(sw_hi_min, cisd_s, depth_s) + " -> no CISD"
                f_push_row(f_hour_row())
                if show_debug and skip_hour != ""
                    label.new(cur_hs + 1800000, ph, skip_hour, xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)
            prev_ok := ch_bars >= 30 and cur_hs == hs - HOUR_MS
            ph := ch_hi
            pl := ch_lo
            ph_bar := ch_hi_bar
            pl_bar := ch_lo_bar
        // 2. mở giờ mới
        cur_hs := hs
        ch_hi := high
        ch_lo := low
        ch_hi_bar := bar_index
        ch_lo_bar := bar_index
        ch_bars := 0
        int hr = hour(time, TZ)
        int dow = dayofweek(time, TZ)
        target_hr := (hr == 3 or hr == 9) and (dow == dayofweek.tuesday or dow == dayofweek.wednesday or dow == dayofweek.thursday)
        in_window := time >= NOW - days_back * DAY_MS
        open_in := prev_ok and open >= pl and open <= ph
        skip_hour := not target_hr ? "" : not prev_ok ? "SKIP no prev hour" : (na(atr) or atr <= 0) ? "SKIP no ATR" : not open_in ? "SKIP open OUT (" + f_p(open) + ")" : ""
        in_scope := target_hr and skip_hour == ""
        lo_bar := na
        lo_px := na
        sw_lo_min := na
        hi_bar := na
        hi_px := na
        sw_hi_min := na
        sw_lo_lb := na
        sw_hi_lb := na
        cisd_b := na
        cisd_s := na
        cisd_b_org := na
        cisd_s_org := na
        cisd_b_lvl := na
        cisd_s_lvl := na
        depth_b := na
        depth_s := na
        buy_done := false
        sell_done := false
        res_b := ""
        res_s := ""
        cur_state := target_hr ? (skip_hour != "" ? skip_hour : "quan sát, chờ quét") : "ngoài giờ"
        if show_prev_hl and target_hr and prev_ok and in_window
            line.new(ph_bar, ph, bar_index + 59, ph, xloc = xloc.bar_index, color = col_prev_hl, style = line.style_dotted, width = 1)
            line.new(pl_bar, pl, bar_index + 59, pl, xloc = xloc.bar_index, color = col_prev_hl, style = line.style_dotted, width = 1)

    ch_bars += 1
    if high > ch_hi
        ch_hi := high
        ch_hi_bar := bar_index
    if low < ch_lo
        ch_lo := low
        ch_lo_bar := bar_index

    if in_scope
        bool sweep_now_lo = false
        bool sweep_now_hi = false
        bool newlo_now = false
        bool newhi_now = false
        // --- quét và cực trị chạy ---
        if na(sw_lo_min)
            if m <= sweep_max_min and low < pl
                sw_lo_min := m
                lo_bar := bar_index
                lo_px := low
                sweep_now_lo := true
                if show_sweep and in_window
                    sw_lo_lb := label.new(bar_index, low, "", style = label.style_label_up, color = color.new(col_buy, 30), size = size.tiny, tooltip = "Quét đáy giờ trước " + f_p(pl) + "\nquét " + f_m(m) + " | cực trị " + f_m(m) + " " + f_p(low))
        else if not buy_done and na(cisd_b) and low < lo_px
            lo_bar := bar_index
            lo_px := low
            newlo_now := true
            if not na(sw_lo_lb)
                label.set_xy(sw_lo_lb, bar_index, low)
                label.set_tooltip(sw_lo_lb, "Quét đáy giờ trước " + f_p(pl) + "\nquét " + f_m(sw_lo_min) + " | cực trị " + f_m(m) + " " + f_p(low))
        if na(sw_hi_min)
            if m <= sweep_max_min and high > ph
                sw_hi_min := m
                hi_bar := bar_index
                hi_px := high
                sweep_now_hi := true
                if show_sweep and in_window
                    sw_hi_lb := label.new(bar_index, high, "", style = label.style_label_down, color = color.new(col_sell, 30), size = size.tiny, tooltip = "Quét đỉnh giờ trước " + f_p(ph) + "\nquét " + f_m(m) + " | cực trị " + f_m(m) + " " + f_p(high))
        else if not sell_done and na(cisd_s) and high > hi_px
            hi_bar := bar_index
            hi_px := high
            newhi_now := true
            if not na(sw_hi_lb)
                label.set_xy(sw_hi_lb, bar_index, high)
                label.set_tooltip(sw_hi_lb, "Quét đỉnh giờ trước " + f_p(ph) + "\nquét " + f_m(sw_hi_min) + " | cực trị " + f_m(m) + " " + f_p(high))

        // --- quét cả hai biên: bỏ mọi phía chưa có tín hiệu ---
        if not na(sw_lo_min) and not na(sw_hi_min)
            if not buy_done
                buy_done := true
                res_b := f_side_prefix(sw_lo_min, cisd_b, depth_b) + " -> SKIP 2 sides"
            if not sell_done
                sell_done := true
                res_s := f_side_prefix(sw_hi_min, cisd_s, depth_s) + " -> SKIP 2 sides"
            cur_state := "SKIP quét 2 biên"

        // --- phía mua ---
        if not na(sw_lo_min) and not buy_done
            if na(cisd_b)
                if m > cisd_max_min
                    buy_done := true
                    res_b := f_side_prefix(sw_lo_min, cisd_b, depth_b) + " -> no CISD"
                    cur_state := "hết phút " + str.tostring(cisd_max_min) + ", không CISD mua"
                else if not sweep_now_lo and not newlo_now
                    int k = bar_index - lo_bar
                    [lvl_b, org_b] = f_cisd_lvl_buy(k)
                    if close > lvl_b
                        float d = (pl - lo_px) / atr
                        depth_b := d
                        if d >= depth_max_atr
                            buy_done := true
                            res_b := "sweep " + f_m(sw_lo_min) + " CISD " + f_m(m) + " depth " + f_2(d) + " -> SKIP deep"
                            if alert_cisd
                                alert("[BỎ] " + f_sess() + " — CISD BUY phút " + str.tostring(m) + " | quét " + f_2(d) + " ATR ≥ " + f_2(depth_max_atr) + " (quét sâu)", alert.freq_once_per_bar_close)
                            cur_state := "CISD mua nhưng quét sâu " + f_2(d) + " ATR"
                        else
                            cisd_b := bar_index
                            cisd_b_org := bar_index - org_b
                            cisd_b_lvl := lvl_b
                            [fo, bot, top] = f_fvg_buy(k)
                            if not na(fo)
                                buy_done := true
                                res_b := "sweep " + f_m(sw_lo_min) + " CISD " + f_m(m) + " depth " + f_2(d) + " FVG " + f_1((top - bot) / pip) + "p " + f_m(minute(time[fo], TZ)) + " -> SIGNAL BUY"
                                cur_state := "SIGNAL BUY " + f_m(m)
                                if in_window
                                    f_draw_cisd(cisd_b_org, bar_index, cisd_b_lvl, col_buy)
                                    f_cisd_label(cisd_b_org, bar_index, cisd_b_lvl, col_buy, "CISD " + f_m(m), "CISD BUY " + f_m(m) + "\nmức " + f_p(cisd_b_lvl) + " | đóng " + f_p(close) + "\nquét " + f_2(d) + " ATR | cực trị " + f_p(lo_px))
                                    if not na(sw_lo_lb)
                                        label.set_xy(sw_lo_lb, lo_bar, lo_px)
                                    box.new(bar_index - fo, top, bar_index + (59 - m), bot, border_color = col_buy, bgcolor = color.new(col_buy, 80))
                                    label.new(bar_index - fo + math.round((59 - m + fo) / 2), (top + bot) / 2, "FVG " + f_1((top - bot) / pip) + "p", style = label.style_none, textcolor = col_buy, size = size.tiny, tooltip = "FVG mua " + f_1((top - bot) / pip) + " pip | " + f_p(bot) + " – " + f_p(top) + " | hoàn thành " + f_m(minute(time[fo], TZ)) + "\nCISD BUY " + f_m(m) + " | mức " + f_p(cisd_b_lvl) + " | đóng " + f_p(close) + "\nquét " + f_2(d) + " ATR | cực trị " + f_p(lo_px))
                                alert("[SETUP] " + f_sess() + " — CISD BUY + FVG | CISD phút " + str.tostring(m) + " | quét " + f_2(d) + " ATR | FVG " + f_p(bot) + "–" + f_p(top) + " (" + f_1((top - bot) / pip) + " pip)", alert.freq_once_per_bar_close)
                            else
                                cur_state := "CISD mua " + f_m(m) + ", chờ FVG 1 nến"
                                if alert_cisd
                                    alert("[CHỜ] " + f_sess() + " — CISD BUY phút " + str.tostring(m) + " | quét " + f_2(d) + " ATR | chưa có FVG, chờ nến kế tiếp", alert.freq_once_per_bar_close)
            else
                // nến ngay sau CISD: FVG với nến giữa = nến CISD
                float b = high[2]
                float t = low
                if t - b >= min_gap and t > b
                    buy_done := true
                    res_b := "sweep " + f_m(sw_lo_min) + " CISD " + f_m(minute(time[1], TZ)) + " depth " + f_2(depth_b) + " FVG " + f_1((t - b) / pip) + "p " + f_m(m) + " -> SIGNAL BUY"
                    cur_state := "SIGNAL BUY " + f_m(m)
                    if in_window
                        f_draw_cisd(cisd_b_org, cisd_b, cisd_b_lvl, col_buy)
                        f_cisd_label(cisd_b_org, cisd_b, cisd_b_lvl, col_buy, "CISD " + f_m(minute(time[1], TZ)), "CISD BUY " + f_m(minute(time[1], TZ)) + "\nmức " + f_p(cisd_b_lvl) + " | đóng " + f_p(close[1]) + "\nquét " + f_2(depth_b) + " ATR | cực trị " + f_p(lo_px))
                        if not na(sw_lo_lb)
                            label.set_xy(sw_lo_lb, lo_bar, lo_px)
                        box.new(bar_index, t, bar_index + (59 - m), b, border_color = col_buy, bgcolor = color.new(col_buy, 80))
                        label.new(bar_index + math.round((59 - m) / 2), (t + b) / 2, "FVG " + f_1((t - b) / pip) + "p", style = label.style_none, textcolor = col_buy, size = size.tiny, tooltip = "FVG mua " + f_1((t - b) / pip) + " pip | " + f_p(b) + " – " + f_p(t) + " | hoàn thành " + f_m(m) + "\nCISD BUY " + f_m(minute(time[1], TZ)) + " | mức " + f_p(cisd_b_lvl) + " | đóng " + f_p(close[1]) + "\nquét " + f_2(depth_b) + " ATR | cực trị " + f_p(lo_px))
                    alert("[SETUP] " + f_sess() + " — CISD BUY + FVG | CISD phút " + str.tostring(minute(time[1], TZ)) + " | quét " + f_2(depth_b) + " ATR | FVG " + f_p(b) + "–" + f_p(t) + " (" + f_1((t - b) / pip) + " pip)", alert.freq_once_per_bar_close)
                else
                    buy_done := true
                    res_b := "sweep " + f_m(sw_lo_min) + " CISD " + f_m(minute(time[1], TZ)) + " depth " + f_2(depth_b) + " -> SKIP no FVG"
                    if alert_cisd
                        alert("[BỎ] " + f_sess() + " — CISD BUY phút " + str.tostring(minute(time[1], TZ)) + " không có FVG", alert.freq_once_per_bar_close)
                    cur_state := "CISD mua không có FVG, bỏ"
                    if show_debug and in_window
                        label.new(cisd_b, cisd_b_lvl, "CISD no FVG", style = label.style_label_left, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)
                        f_draw_cisd(cisd_b_org, cisd_b, cisd_b_lvl, color.new(color.gray, 40))

        // --- phía bán ---
        if not na(sw_hi_min) and not sell_done
            if na(cisd_s)
                if m > cisd_max_min
                    sell_done := true
                    res_s := f_side_prefix(sw_hi_min, cisd_s, depth_s) + " -> no CISD"
                    cur_state := "hết phút " + str.tostring(cisd_max_min) + ", không CISD bán"
                else if not sweep_now_hi and not newhi_now
                    int k = bar_index - hi_bar
                    [lvl_s, org_s] = f_cisd_lvl_sell(k)
                    if close < lvl_s
                        float d = (hi_px - ph) / atr
                        depth_s := d
                        if d >= depth_max_atr
                            sell_done := true
                            res_s := "sweep " + f_m(sw_hi_min) + " CISD " + f_m(m) + " depth " + f_2(d) + " -> SKIP deep"
                            if alert_cisd
                                alert("[BỎ] " + f_sess() + " — CISD SELL phút " + str.tostring(m) + " | quét " + f_2(d) + " ATR ≥ " + f_2(depth_max_atr) + " (quét sâu)", alert.freq_once_per_bar_close)
                            cur_state := "CISD bán nhưng quét sâu " + f_2(d) + " ATR"
                        else
                            cisd_s := bar_index
                            cisd_s_org := bar_index - org_s
                            cisd_s_lvl := lvl_s
                            [fo, bot, top] = f_fvg_sell(k)
                            if not na(fo)
                                sell_done := true
                                res_s := "sweep " + f_m(sw_hi_min) + " CISD " + f_m(m) + " depth " + f_2(d) + " FVG " + f_1((top - bot) / pip) + "p " + f_m(minute(time[fo], TZ)) + " -> SIGNAL SELL"
                                cur_state := "SIGNAL SELL " + f_m(m)
                                if in_window
                                    f_draw_cisd(cisd_s_org, bar_index, cisd_s_lvl, col_sell)
                                    f_cisd_label(cisd_s_org, bar_index, cisd_s_lvl, col_sell, "CISD " + f_m(m), "CISD SELL " + f_m(m) + "\nmức " + f_p(cisd_s_lvl) + " | đóng " + f_p(close) + "\nquét " + f_2(d) + " ATR | cực trị " + f_p(hi_px))
                                    if not na(sw_hi_lb)
                                        label.set_xy(sw_hi_lb, hi_bar, hi_px)
                                    box.new(bar_index - fo, top, bar_index + (59 - m), bot, border_color = col_sell, bgcolor = color.new(col_sell, 80))
                                    label.new(bar_index - fo + math.round((59 - m + fo) / 2), (top + bot) / 2, "FVG " + f_1((top - bot) / pip) + "p", style = label.style_none, textcolor = col_sell, size = size.tiny, tooltip = "FVG bán " + f_1((top - bot) / pip) + " pip | " + f_p(bot) + " – " + f_p(top) + " | hoàn thành " + f_m(minute(time[fo], TZ)) + "\nCISD SELL " + f_m(m) + " | mức " + f_p(cisd_s_lvl) + " | đóng " + f_p(close) + "\nquét " + f_2(d) + " ATR | cực trị " + f_p(hi_px))
                                alert("[SETUP] " + f_sess() + " — CISD SELL + FVG | CISD phút " + str.tostring(m) + " | quét " + f_2(d) + " ATR | FVG " + f_p(bot) + "–" + f_p(top) + " (" + f_1((top - bot) / pip) + " pip)", alert.freq_once_per_bar_close)
                            else
                                cur_state := "CISD bán " + f_m(m) + ", chờ FVG 1 nến"
                                if alert_cisd
                                    alert("[CHỜ] " + f_sess() + " — CISD SELL phút " + str.tostring(m) + " | quét " + f_2(d) + " ATR | chưa có FVG, chờ nến kế tiếp", alert.freq_once_per_bar_close)
            else
                float t = low[2]
                float b = high
                if t - b >= min_gap and t > b
                    sell_done := true
                    res_s := "sweep " + f_m(sw_hi_min) + " CISD " + f_m(minute(time[1], TZ)) + " depth " + f_2(depth_s) + " FVG " + f_1((t - b) / pip) + "p " + f_m(m) + " -> SIGNAL SELL"
                    cur_state := "SIGNAL SELL " + f_m(m)
                    if in_window
                        f_draw_cisd(cisd_s_org, cisd_s, cisd_s_lvl, col_sell)
                        f_cisd_label(cisd_s_org, cisd_s, cisd_s_lvl, col_sell, "CISD " + f_m(minute(time[1], TZ)), "CISD SELL " + f_m(minute(time[1], TZ)) + "\nmức " + f_p(cisd_s_lvl) + " | đóng " + f_p(close[1]) + "\nquét " + f_2(depth_s) + " ATR | cực trị " + f_p(hi_px))
                        if not na(sw_hi_lb)
                            label.set_xy(sw_hi_lb, hi_bar, hi_px)
                        box.new(bar_index, t, bar_index + (59 - m), b, border_color = col_sell, bgcolor = color.new(col_sell, 80))
                        label.new(bar_index + math.round((59 - m) / 2), (t + b) / 2, "FVG " + f_1((t - b) / pip) + "p", style = label.style_none, textcolor = col_sell, size = size.tiny, tooltip = "FVG bán " + f_1((t - b) / pip) + " pip | " + f_p(b) + " – " + f_p(t) + " | hoàn thành " + f_m(m) + "\nCISD SELL " + f_m(minute(time[1], TZ)) + " | mức " + f_p(cisd_s_lvl) + " | đóng " + f_p(close[1]) + "\nquét " + f_2(depth_s) + " ATR | cực trị " + f_p(hi_px))
                    alert("[SETUP] " + f_sess() + " — CISD SELL + FVG | CISD phút " + str.tostring(minute(time[1], TZ)) + " | quét " + f_2(depth_s) + " ATR | FVG " + f_p(b) + "–" + f_p(t) + " (" + f_1((t - b) / pip) + " pip)", alert.freq_once_per_bar_close)
                else
                    sell_done := true
                    res_s := "sweep " + f_m(sw_hi_min) + " CISD " + f_m(minute(time[1], TZ)) + " depth " + f_2(depth_s) + " -> SKIP no FVG"
                    if alert_cisd
                        alert("[BỎ] " + f_sess() + " — CISD SELL phút " + str.tostring(minute(time[1], TZ)) + " không có FVG", alert.freq_once_per_bar_close)
                    cur_state := "CISD bán không có FVG, bỏ"
                    if show_debug and in_window
                        label.new(cisd_s, cisd_s_lvl, "CISD no FVG", style = label.style_label_left, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)
                        f_draw_cisd(cisd_s_org, cisd_s, cisd_s_lvl, color.new(color.gray, 40))

        if m == 55
            cur_state := "phút 55: đóng lệnh còn mở"

// =============================================================================
// HIGH/LOW KILLZONE, NGÀY TRƯỚC, TUẦN TRƯỚC
// Killzone: vùng tô từ High đến Low của phiên; đường bắt đầu tại nến tạo đỉnh/đáy, kéo đến hết nến D (17:00 NY) chứa
// nến đầu tiên sau phiên; bị quét thì dừng tại nến quét.
// PDH/PDL và PWH/PWL: theo nến D/W của TradingView (request.security với [1] + lookahead_on: không repaint), kéo đến hết nến D/W
// hiện tại; bị quét thì dừng tại nến quét như killzone.
// Nhãn đi theo nến hiện tại khi đường còn hiệu lực; khi bị quét, nhãn đứng lại tại điểm quét và thêm ✗.
// =============================================================================
type HL
    line  ln
    label lb
    float lvl
    bool  is_high
    int   end_t
    bool  sweepable
    bool  active

var array<HL> hl_arr = array.new<HL>()

// chữ đen trên nền sáng (vàng, trắng), chữ trắng trên nền tối
f_txt_on(color c) => color.r(c) * 0.299 + color.g(c) * 0.587 + color.b(c) * 0.114 > 150 ? color.black : color.white

f_hl_new(int x1_t, float lvl, int end_t, bool is_high, bool sweepable, string txt, color c) =>
    line  ln = line.new(x1_t, lvl, end_t, lvl, xloc = xloc.bar_time, color = c, style = line.style_solid, width = hl_width)
    label lb = label.new(bar_index + hl_lbl_off, lvl, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(c, 15), textcolor = f_txt_on(c), size = size.small)
    array.push(hl_arr, HL.new(ln, lb, lvl, is_high, end_t, sweepable, true))
    true

// cập nhật các đường còn hiệu lực trên mỗi nến
if array.size(hl_arr) > 0
    for i = 0 to array.size(hl_arr) - 1
        HL h = array.get(hl_arr, i)
        if h.active
            bool swept = h.sweepable and (h.is_high ? high > h.lvl : low < h.lvl)
            if swept
                line.set_x2(h.ln, time)
                if hl_hide_swept
                    label.delete(h.lb)
                else
                    // nhãn đứng lại tại điểm quét, đặt về phía ngược với hướng phá (đỉnh bị quét: dưới đường; đáy: trên đường)
                    label.set_x(h.lb, bar_index)
                    label.set_style(h.lb, h.is_high ? label.style_label_upper_left : label.style_label_lower_left)
                    label.set_size(h.lb, size.tiny)
                    label.set_text(h.lb, label.get_text(h.lb) + " ✗")
                h.active := false
            else if time >= h.end_t
                label.set_x(h.lb, bar_index)
                h.active := false
            else
                label.set_x(h.lb, bar_index + hl_lbl_off)

// ---- killzone ----
f_kz_track(string sess, string name, color c, bool enabled) =>
    var float kh = na
    var float kl = na
    var int   kh_t = na
    var int   kl_t = na
    var box   bx = na
    bool in_s = not na(time(timeframe.period, sess, TZ))
    bool in_win = time >= NOW - hl_days_back * DAY_MS
    if in_s
        if not in_s[1]
            kh := high
            kl := low
            kh_t := time
            kl_t := time
            bx := show_kz_box and enabled and in_win ? box.new(time, high, time, low, xloc = xloc.bar_time, border_color = color.new(c, 70), bgcolor = color.new(c, kz_box_transp)) : box(na)
        else
            if high > kh
                kh := high
                kh_t := time
            if low < kl
                kl := low
                kl_t := time
        if not na(bx)
            box.set_top(bx, kh)
            box.set_bottom(bx, kl)
            box.set_right(bx, time)
    else if in_s[1] and enabled and not na(kh)
        // nến đầu tiên sau phiên: kéo đến hết nến D (TradingView/OANDA: 17:00 NY) chứa nến này
        if in_win
            f_hl_new(kh_t, kh, time_close("D"), true, true, name + " H", c)
            f_hl_new(kl_t, kl, time_close("D"), false, true, name + " L", c)
    in_s

if show_kz_hl
    f_kz_track(sess_asia, "ASIA", col_asia_hl, true)
    f_kz_track(sess_london, "LDN", col_ldn_hl, true)
    f_kz_track(sess_ny, "NY", col_ny_hl, true)

// ---- ngày trước / tuần trước: theo nến D và W của TradingView (OANDA: ngày 17:00–17:00 NY) ----
[pdh_s, pdl_s] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh_s, pwl_s] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
var float pdh = na
var float pdl = na
var float pwh = na
var float pwl = na
pdh := pdh_s
pdl := pdl_s
pwh := pwh_s
pwl := pwl_s
bool new_day  = ta.change(time("D")) != 0
bool new_week = ta.change(time("W")) != 0
if new_day and show_pd_hl and not na(pdh) and time >= NOW - hl_days_back * DAY_MS
    f_hl_new(time, pdh, time_close("D"), true, true, "PDH", col_pd_hl)
    f_hl_new(time, pdl, time_close("D"), false, true, "PDL", col_pd_hl)
if new_week and show_pw_hl and not na(pwh) and time >= NOW - hl_days_back * 7 * DAY_MS
    f_hl_new(time, pwh, time_close("W"), true, true, "PWH", col_pw_hl)
    f_hl_new(time, pwl, time_close("W"), false, true, "PWL", col_pw_hl)

// =============================================================================
// BẢNG TRẠNG THÁI VÀ BẢNG ĐỐI CHIẾU
// =============================================================================
var table st = table.new(position.top_right, 2, 8, border_width = 1)
if barstate.islast and show_status and enable_sig
    color hdr = color.new(color.gray, 70)
    string warn = not is_m1 ? "CHUYỂN SANG M1" : not is_pair ? "chỉ đo trên EURUSD/GBPUSD" : "OK"
    table.cell(st, 0, 0, "Symbol / TF", bgcolor = hdr, text_size = size.small)
    table.cell(st, 1, 0, syminfo.ticker + " " + timeframe.period + " — " + warn, text_color = warn == "OK" ? color.green : color.red, text_size = size.small)
    table.cell(st, 0, 1, "Giờ NY", bgcolor = hdr, text_size = size.small)
    table.cell(st, 1, 1, str.format_time(time, "EEE HH:mm", TZ) + (target_hr ? " (giờ setup)" : ""), text_size = size.small)
    table.cell(st, 0, 2, "Biên giờ trước", bgcolor = hdr, text_size = size.small)
    table.cell(st, 1, 2, na(ph) ? "—" : "PH " + f_p(ph) + "  PL " + f_p(pl) + (prev_ok ? "" : " (thiếu)"), text_size = size.small)
    table.cell(st, 0, 3, "ATR24 H1", bgcolor = hdr, text_size = size.small)
    table.cell(st, 1, 3, na(atr) ? "—" : f_1(atr / pip) + " pip | quét nông < " + f_1(depth_max_atr * atr / pip) + " pip", text_size = size.small)
    table.cell(st, 0, 4, "Trạng thái", bgcolor = hdr, text_size = size.small)
    table.cell(st, 1, 4, cur_state, text_color = str.startswith(cur_state, "SIGNAL") ? color.green : color.white, text_size = size.small)
    table.cell(st, 0, 5, "Quy tắc", bgcolor = hdr, text_size = size.small)
    table.cell(st, 1, 5, "v1.1: CISD ≤p" + str.tostring(cisd_max_min) + " + FVG ≥ " + f_1(min_fvg_pip) + "p, quét < " + f_2(depth_max_atr) + " ATR", text_size = size.small)
    table.cell(st, 0, 6, "PDH / PDL", bgcolor = hdr, text_size = size.small)
    table.cell(st, 1, 6, na(pdh) ? "—" : f_p(pdh) + " / " + f_p(pdl), text_size = size.small)
    table.cell(st, 0, 7, "PWH / PWL", bgcolor = hdr, text_size = size.small)
    table.cell(st, 1, 7, na(pwh) ? "—" : f_p(pwh) + " / " + f_p(pwl), text_size = size.small)

var table dbg = table.new(position.bottom_left, 1, 61, border_width = 1)
if barstate.islast and show_debug and enable_sig
    table.cell(dbg, 0, 0, "Đối chiếu " + str.tostring(days_back) + " ngày (mới nhất ở trên) — so với verify_indicator.py", bgcolor = color.new(color.gray, 60), text_size = size.small, text_halign = text.align_left)
    int n = array.size(dbg_rows)
    for i = 0 to debug_rows - 1
        string txt = i < n ? array.get(dbg_rows, n - 1 - i) : ""
        table.cell(dbg, 0, i + 1, txt, text_size = size.tiny, text_halign = text.align_left, text_color = str.contains(txt, "SIGNAL") ? color.green : color.silver)
